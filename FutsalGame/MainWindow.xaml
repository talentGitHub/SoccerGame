<Window x:Class="FutsalGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FutsalGame"
        mc:Ignorable="d"
        Title="Futsal Game - 5v5" Height="700" Width="1200"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Score and Timer Panel -->
        <Border Grid.Row="0" Background="#1a1a1a" BorderBrush="#333333" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Red Team Score -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="RED TEAM" FontSize="20" FontWeight="Bold" Foreground="#ff4444" Margin="0,0,20,0"/>
                    <TextBlock x:Name="RedScoreText" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <!-- Timer -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">
                    <TextBlock x:Name="TimerText" Text="00:00" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GameStatusText" Text="Press SPACE to Start" FontSize="12" Foreground="#aaaaaa" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Blue Team Score -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="BlueScoreText" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="BLUE TEAM" FontSize="20" FontWeight="Bold" Foreground="#4444ff" Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Game Canvas -->
        <Border Grid.Row="1" Background="#2a2a2a">
            <Canvas x:Name="GameCanvas" 
                    Background="#1e7c1e"
                    Width="1000" 
                    Height="600"
                    ClipToBounds="True">
                <!-- Field will be drawn here -->
            </Canvas>
        </Border>

        <!-- Controls Panel -->
        <Border Grid.Row="2" Background="#1a1a1a" BorderBrush="#333333" BorderThickness="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Control Instructions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Controls: WASD (Move) | SPACE (Start/Pause) | R (Reset)" 
                              FontSize="14" 
                              Foreground="#aaaaaa"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,5">
                    <Button x:Name="PassButton" 
                            Content="PASS" 
                            Width="100" 
                            Height="35"
                            Margin="5"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PassButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45a049"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#3d8b40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button x:Name="KickButton" 
                            Content="KICK" 
                            Width="100" 
                            Height="35"
                            Margin="5"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#FF5722"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="KickButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF5722"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E64A19"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#D84315"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <!-- Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ActionStatusText" Text="" 
                              FontSize="12" 
                              FontWeight="Bold"
                              Foreground="#ffcc00"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
